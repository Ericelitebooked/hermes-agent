# ============================================================================
# HERMES AI LEAD QUALIFIER - Environment Variables
# ============================================================================
# Copy this to .env and fill in your real values
# NEVER commit .env to git (it's in .gitignore)

# ANTHROPIC - The AI Brain
# Get from: platform.anthropic.com → API Keys → Create Key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-

# ELEVENLABS - AI Voice for Calls
# Get from: elevenlabs.io → Profile + API Key
ELEVEN_API_KEY=

# ELEVENLABS - Voice Selection
# Get from: elevenlabs.io → Voices → open voice → copy Voice ID from URL after /voices/
ELEVEN_VOICE_ID=

# TWILIO - Phone Calling Service
# Get from: twilio.com → Dashboard → Account SID (starts with AC)
TWILIO_ACCOUNT_SID=AC

# TWILIO - Authentication
# Get from: twilio.com → Dashboard → Auth Token
TWILIO_AUTH_TOKEN=

# TWILIO - Your Phone Number
# Get from: twilio.com → Phone Numbers → Manage → Your number
# IMPORTANT: Include country code, e.g., +1234567890
TWILIO_PHONE_NUMBER=+1

# CAL.COM - Calendar API Key
# Get from: cal.com → Settings → Developer → API Keys → Create
CAL_API_KEY=

# CAL.COM - Your Username
# Get from: Your cal.com profile URL (username part only)
CAL_USERNAME=

# CAL.COM - Event Type ID
# Get from: cal.com → Open Event Type → number at end of URL
CAL_EVENT_TYPE_ID=

# GOOGLE SHEETS - Service Account Email
# Get from: console.cloud.google.com → Service Accounts → JSON key file → client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# GOOGLE SHEETS - Private Key
# Get from: console.cloud.google.com → Service Accounts → JSON key file → private_key
# IMPORTANT: Keep on ONE line, keep quotes, keep \n sequences literal
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GOOGLE SHEETS - Sheet ID
# Get from: sheets.google.com → Your sheet URL → between /d/ and /edit
GOOGLE_SHEET_ID=

# SERVER - Permanent URL
# Get from: Hostinger Docker Manager → Open the lead-agent-video container
# Format: https://lead-agent-video.srv1728628.hstgr.cloud (NO trailing slash)
SERVER_URL=https://

# OWNER - Alert Phone Number
# Format: +1234567890 with country code
OWNER_PHONE_NUMBER=+1

# TIMEZONE - For all time displays and Cal.com bookings
# Examples: America/New_York, America/Los_Angeles, Europe/London, Asia/Dubai
# CRITICAL: This affects when slots are shown to callers
TIMEZONE=America/New_York

# PORT - Local development port
# Default: 3000 (must match docker-compose.yml port mapping)
PORT=3000
